{
  "manifest_version": 3,
  "name": "Strict Switch",
  "version": "0.4.2",
  "description": "Strict-level tracker blocking on top of Edge's Basic tracking prevention, with a one-click step-down to Balanced or Basic per site.",
  "minimum_chrome_version": "121",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "activeTab",
    "history",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Strict Switch",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "advertising",
        "enabled": true,
        "path": "rules/advertising.json"
      },
      {
        "id": "analytics",
        "enabled": true,
        "path": "rules/analytics.json"
      },
      {
        "id": "social",
        "enabled": true,
        "path": "rules/social.json"
      },
      {
        "id": "fingerprinting",
        "enabled": true,
        "path": "rules/fingerprinting.json"
      },
      {
        "id": "cryptomining",
        "enabled": true,
        "path": "rules/cryptomining.json"
      },
      {
        "id": "content",
        "enabled": false,
        "path": "rules/content.json"
      }
    ]
  }
}
