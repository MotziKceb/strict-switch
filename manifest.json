{
  "manifest_version": 3,
  "name": "Strict Switch",
  "version": "0.9.0",
  "description": "Strict tracker blocking with one-click per-site levels, per-company control and a plain-language activity log.",
  "minimum_chrome_version": "121",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "activeTab",
    "history",
    "alarms"
  ],
  "optional_permissions": [
    "notifications",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; connect-src 'self'; base-uri 'none'"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Strict Switch",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "advertising",
        "enabled": true,
        "path": "rules/advertising.json"
      },
      {
        "id": "analytics",
        "enabled": true,
        "path": "rules/analytics.json"
      },
      {
        "id": "social",
        "enabled": true,
        "path": "rules/social.json"
      },
      {
        "id": "fingerprinting",
        "enabled": true,
        "path": "rules/fingerprinting.json"
      },
      {
        "id": "cryptomining",
        "enabled": true,
        "path": "rules/cryptomining.json"
      },
      {
        "id": "content",
        "enabled": false,
        "path": "rules/content.json"
      },
      {
        "id": "observe",
        "enabled": true,
        "path": "rules/observe.json"
      }
    ]
  }
}
